<!-- Komponen Interaktif Bootstrap Modals Dialog -->
<div class="modal fade" id="modalKontak" tabindex="-1" aria-labelledby="modalKontakLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalKontakLabel">Formulir Pesan Konsultasi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form>
                    <div class="mb-3">
                        <label for="form-email" class="form-label fw-semibold">Alamat Email Aktif</label>
                        <input type="email" class="form-control" id="form-email" placeholder="nama@sekolah.sch.id" required>
                    </div>
                    <div class="mb-3">
                        <label for="form-pesan" class="form-label fw-semibold">Isi Keperluan Pesan</label>
                        <textarea class="form-control" id="form-pesan" rows="4" placeholder="Tulis rincian kebutuhan web application Anda..." required></textarea>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-bold">Kirim Pesan Sekarang</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
